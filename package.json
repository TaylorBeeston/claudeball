{
  "name": "claudeball",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "hdri": "node scripts/fetch-hdri.mjs",
    "test": "vitest run",
    "sim": "tsx scripts/simulate.ts",
    "announcer:script": "tsx tools/announcer/script/generate.ts",
    "announcer:record": "vite --config tools/announcer/recorder/vite.config.ts",
    "announcer:record:e2e": "tsx tools/announcer/recorder/e2e/recorder.e2e.ts",
    "announcer:vocab": "tsx tools/announcer/script/words.ts",
    "announcer:setup": "bash tools/announcer/train/setup.sh",
    "announcer:prep": "bash tools/announcer/train/run.sh prep",
    "announcer:train": "bash tools/announcer/train/run.sh train",
    "announcer:export": "bash tools/announcer/train/run.sh export",
    "announcer:test": "tsx tools/announcer/train/web_test.ts ${CB_VOICEPACK:-${CB_DATA_DIR:-${CB_VOICE_DIR:-$HOME/claudeball-voice}}/voicepack}",
    "announcer:pilot": "bash tools/announcer/train/pilot.sh",
    "announcer:clips": "bash tools/announcer/train/run.sh clips",
    "announcer:test:game": "tsx tools/announcer/train/game_test.ts",
    "perf": "tsx tools/perf/run.ts",
    "perf:gpu": "tsx tools/perf/run.ts --uncapped",
    "perf:emu": "tsx tools/perf/run.ts --target emu",
    "perf:phone": "tsx tools/perf/run.ts --target phone",
    "perf:report": "tsx tools/perf/report.ts",
    "perf:check": "tsx tools/perf/check.ts",
    "assets:derive": "node scripts/derive-assets.mjs"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/node": "^26.6.3",
    "@types/three": "^0.186.0",
    "meshoptimizer": "^1.3.0",
    "onnxruntime-web": "^1.30.0",
    "playwright-core": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^4.1.11"
  }
}
