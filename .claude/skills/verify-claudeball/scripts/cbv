#!/usr/bin/env bash
# verify-claudeball harness entry point: cbv <command> [options]   (cbv help)
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(cd "$here/../../../.." && pwd)"
if [ ! -x "$root/node_modules/.bin/tsx" ]; then echo "[cbv] no node_modules in $root: run 'npm ci' first" >&2; exit 2; fi
cd "$root"
exec node "$root/node_modules/tsx/dist/cli.mjs" "$here/cbv.ts" "$@"
